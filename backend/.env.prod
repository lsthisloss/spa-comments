# Database для PROD (без -dev суффиксов)
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_NAME=spa_comments
DB_URL=postgresql://postgres:your_secure_password_here@postgres:5432/spa_comments

# Elasticsearch для PROD
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# RabbitMQ для PROD
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=secure_rabbitmq_password

# JWT - ОБЯЗАТЕЛЬНО ПОМЕНЯЙ НА СЛУЧАЙНЫЙ
JWT_SECRET=2446errggdfwer43253qvrtSWDCr

# Vite (для фронтенда)
VITE_API_URL=http://localhost:3001
VITE_SOCKET_URL=http://localhost:3001

RABBITMQ_QUEUE_MAX_LENGTH=10000
RABBITMQ_QUEUE_MAX_BYTES=100000000
RABBITMQ_MESSAGE_TTL=600000

# Production settings
FORCE_UPDATE=false
NODE_ENV=production
NODE_OPTIONS=--max-old-space-size=1024
LOG_LEVEL=info