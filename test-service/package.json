{
  "name": "test-service",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test-menu": "tsx src/test-runner.ts",
    "lint": "eslint src/**/*.ts",
    "clean": "rm -rf dist",
    "test:unit": "jest --selectProjects unit --no-coverage",
    "test:integration": "jest --selectProjects integration --no-coverage", 
    "test:smoke": "jest --selectProjects smoke --no-coverage",
    "test:e2e": "jest --selectProjects e2e --no-coverage",
    "test:all": "jest",
    "test:watch": "jest --watch"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@jest/globals": "^30.0.4",
    "@types/amqplib": "^0.10.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.15",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.37.0",
    "@typescript-eslint/parser": "^8.37.0",
    "amqplib": "^0.10.8",
    "eslint": "^9.31.0",
    "jest": "^30.0.4",
    "supertest": "^7.1.3",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
